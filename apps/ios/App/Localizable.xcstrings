      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription limits apply. Recorded time and available token counts are not a billing statement. The conversation limit is local."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn gói đăng ký vẫn được áp dụng. Thời lượng đã ghi và số token khả dụng không phải là hóa đơn. Giới hạn cuộc trò chuyện chỉ áp dụng trên máy này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅限制仍然适用。记录的时间和可用 token 数量不是账单。对话时长限制仅作用于本机。"
          }
        }
      }
    },
