          "stringUnit": {
            "state": "translated",
            "value": "As we talk, useful words and phrases find a home here. Their strength grows when you recall them over time."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi trò chuyện, những từ và cụm từ hữu ích sẽ được lưu lại. Ôn lại theo thời gian sẽ giúp bạn nhớ lâu hơn."
          }
