    "The 850-word library includes English and Chinese content. Vietnamese explanations are generated by your teacher during the lesson.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 850-word library includes English and Chinese content. Vietnamese explanations are generated by your teacher during the lesson."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện 850 từ gồm nội dung tiếng Anh và tiếng Trung. Phần giải thích tiếng Việt được giáo viên tạo trong bài học."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "850 词词库包含英语和中文内容。越南语讲解由老师在课程中实时生成。"
          }
        }
      }
    },
    "The Chinese text was converted from Traditional to Simplified Chinese. Not every meaning and example has been independently checked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chinese text was converted from Traditional to Simplified Chinese. Not every meaning and example has been independently checked."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung tiếng Trung được chuyển từ chữ Phồn thể sang chữ Giản thể. Không phải mọi nghĩa và ví dụ đều đã được kiểm tra độc lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中文文本由繁体中文转换为简体中文。并非每条释义和例句都经过独立核对。"
          }
        }
      }
    },
    "The bars estimate spoken recall, not permanent mastery. Using a word with visible meanings counts as supported practice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bars estimate spoken recall, not permanent mastery. Using a word with visible meanings counts as supported practice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các vạch ước tính khả năng nhớ khi nói, không phải mức độ thành thạo vĩnh viễn. Dùng từ khi có nghĩa hiển thị được tính là luyện tập có hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些格数估计的是口头回忆程度，不代表永久掌握。在显示释义时使用词汇，属于有辅助的练习。"
          }
        }
      }
    },
